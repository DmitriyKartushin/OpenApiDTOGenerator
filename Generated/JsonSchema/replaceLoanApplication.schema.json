{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Request body of PUT /loan-applications/{id} (operationId: replaceLoanApplication), content type application/json",
  "$ref": "#/$defs/LoanApplication",
  "$defs": {
    "Address": {
      "type": "object",
      "description": "Почтовый адрес",
      "required": [
        "region",
        "city",
        "street",
        "house"
      ],
      "properties": {
        "postalCode": {
          "type": "string",
          "pattern": "^\\d{6}$",
          "examples": [
            "101000"
          ]
        },
        "region": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "city": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "street": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "house": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "flat": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 10
        }
      }
    },
    "Applicant": {
      "allOf": [
        {
          "$ref": "#/$defs/Person"
        },
        {
          "type": "object",
          "required": [
            "phone",
            "employment"
          ],
          "properties": {
            "phone": {
              "type": "string",
              "pattern": "^\\+7\\d{10}$"
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "monthlyIncome": {
              "$ref": "#/$defs/Money"
            },
            "registrationAddress": {
              "$ref": "#/$defs/Address"
            },
            "actualAddress": {
              "anyOf": [
                {
                  "description": "Фактический адрес (null — совпадает с регистрацией)",
                  "allOf": [
                    {
                      "$ref": "#/$defs/Address"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "employment": {
              "$ref": "#/$defs/Employment"
            }
          }
        }
      ]
    },
    "Collateral": {
      "oneOf": [
        {
          "$ref": "#/$defs/RealEstateCollateral"
        },
        {
          "$ref": "#/$defs/VehicleCollateral"
        },
        {
          "$ref": "#/$defs/NoCollateral"
        }
      ]
    },
    "Comment": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "replies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Comment"
          }
        }
      }
    },
    "Currency": {
      "type": "string",
      "description": "Код валюты ISO 4217",
      "enum": [
        "RUB",
        "USD",
        "EUR"
      ]
    },
    "Employment": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "EMPLOYED",
            "SELF_EMPLOYED",
            "UNEMPLOYED"
          ]
        },
        "employerName": {
          "type": "string",
          "maxLength": 200
        },
        "experienceMonths": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "LoanApplication": {
      "type": "object",
      "description": "Заявка на кредит",
      "additionalProperties": false,
      "required": [
        "product",
        "requestedAmount",
        "termMonths",
        "applicant",
        "collateral"
      ],
      "properties": {
        "applicationId": {
          "type": "string",
          "format": "uuid",
          "readOnly": true,
          "description": "Присваивается сервером — клиент не передаёт"
        },
        "product": {
          "$ref": "#/$defs/LoanProduct"
        },
        "requestedAmount": {
          "$ref": "#/$defs/Money"
        },
        "termMonths": {
          "type": "integer",
          "minimum": 3,
          "maximum": 360
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "CAR",
            "REAL_ESTATE",
            "EDUCATION",
            "OTHER",
            null
          ]
        },
        "applicant": {
          "$ref": "#/$defs/Applicant"
        },
        "coApplicants": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/Applicant"
          }
        },
        "collateral": {
          "$ref": "#/$defs/Collateral"
        },
        "consents": {
          "type": "array",
          "description": "Согласия заявителя (inline-объекты)",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "accepted"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "PERSONAL_DATA",
                  "CREDIT_BUREAU",
                  "MARKETING"
                ]
              },
              "accepted": {
                "type": "boolean"
              },
              "acceptedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "attributes": {
          "type": "object",
          "description": "Произвольные строковые атрибуты (map)",
          "maxProperties": 10,
          "additionalProperties": {
            "type": "string",
            "maxLength": 255
          }
        },
        "comment": {
          "$ref": "#/$defs/Comment"
        }
      }
    },
    "LoanProduct": {
      "type": "string",
      "enum": [
        "CONSUMER",
        "MORTGAGE",
        "AUTO"
      ]
    },
    "Money": {
      "type": "object",
      "description": "Денежная сумма",
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "number",
          "description": "Сумма (строго больше нуля)",
          "maximum": 1000000000,
          "examples": [
            150000
          ],
          "exclusiveMinimum": 0
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        }
      }
    },
    "NoCollateral": {
      "type": "object",
      "required": [
        "collateralType"
      ],
      "properties": {
        "collateralType": {
          "type": "string",
          "enum": [
            "NONE"
          ]
        }
      }
    },
    "Person": {
      "type": "object",
      "required": [
        "lastName",
        "firstName",
        "birthDate"
      ],
      "properties": {
        "lastName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[А-ЯЁа-яё\\-]+$"
        },
        "firstName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[А-ЯЁа-яё\\-]+$"
        },
        "birthDate": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "RealEstateCollateral": {
      "type": "object",
      "required": [
        "collateralType",
        "cadastralNumber",
        "area",
        "address"
      ],
      "properties": {
        "collateralType": {
          "type": "string",
          "enum": [
            "REAL_ESTATE"
          ]
        },
        "cadastralNumber": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}:\\d{6,7}:\\d+$"
        },
        "area": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "address": {
          "$ref": "#/$defs/Address"
        }
      }
    },
    "VehicleCollateral": {
      "type": "object",
      "required": [
        "collateralType",
        "vin",
        "year"
      ],
      "properties": {
        "collateralType": {
          "type": "string",
          "enum": [
            "VEHICLE"
          ]
        },
        "vin": {
          "type": "string",
          "pattern": "^[A-HJ-NPR-Z0-9]{17}$"
        },
        "year": {
          "type": "integer",
          "minimum": 1990,
          "maximum": 2030
        }
      }
    }
  }
}