{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Request body of POST /loan-applications/{id}/comments, content type application/json",
  "$ref": "#/$defs/Comment",
  "$defs": {
    "Comment": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "replies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Comment"
          }
        }
      }
    }
  }
}